# Required Appwrite configuration
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_PICKUPS_COLLECTION_ID=pickups

# Optional donation image storage
VITE_APPWRITE_BUCKET_ID=

# Optional forward-geocoding endpoint used by Map View
VITE_GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/search
VITE_ROUTING_ENDPOINT=https://router.project-osrm.org

# Optional volunteer routing collections
VITE_APPWRITE_VOLUNTEERS_COLLECTION_ID=
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=

# Server-only Groq key for the Vercel /api/resqbot function. Configure this in
# Vercel Environment Variables; never prefix it with VITE_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional override when the assistant proxy is hosted on another origin.
VITE_ASSISTANT_API_URL=

# Optional EmailJS contact forms
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
